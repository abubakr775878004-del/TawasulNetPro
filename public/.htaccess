# ─────────────────────────────────────────────────────────────────────────────
# SPA Rewrite Rules — Apache / cPanel hosts
#
# Redirects all non-file, non-directory requests to index.html so the
# React app handles routing. Required on Apache-based shared hosting.
# ─────────────────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
